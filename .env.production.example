# Values for the production web build. Set them in your host's environment settings
# (Netlify / Vercel / Cloudflare Pages) or copy to .env.production before `npm run build`.

# The deployed game server (wss://, not ws://). Required for a public release.
VITE_ARENA_WS_URL=wss://arena.example.com

# Supabase project (Settings → API). Enables email + Google sign-in.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Deployed `checkout` edge function. Leave empty until Stripe is set up; the shop then shows "Coming soon".
VITE_CHECKOUT_URL=
