{
  "name": "axiom-arena",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "Axiom Arena — fast-paced competitive math duels with Elo ranked play, seasons and collectible cards.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "art-brief": "node scripts/art-brief.mjs",
    "cards:sync": "node scripts/sync-cards.mjs",
    "preserver:build": "node scripts/sync-cards.mjs",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.mjs --log-level=warning",
    "server": "npm run server:build && node server/dist/index.mjs",
    "e2e": "node scripts/e2e.mjs",
    "start": "node server/dist/index.mjs",
    "prebuild": "node scripts/sync-cards.mjs",
    "pretypecheck": "node scripts/sync-cards.mjs",
    "cards:optimize": "node scripts/optimize-cards.mjs",
    "icons": "node scripts/icons.mjs",
    "og": "node scripts/og-image.mjs",
    "check:supabase": "node scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.10.0",
    "sharp": "^0.35.4",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
