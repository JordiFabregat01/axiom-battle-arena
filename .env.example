# Copy to .env.local and fill in what you use. Everything is optional:
# with nothing set the game runs in guest mode (browser-only saves, simulated opponents).

# ── Game server (authoritative duels, packs, story, profiles) ─────────────────
# Run it with `npm run server` (ws://localhost:8787 by default) or deploy server/ and use wss://…
# When set, the browser never computes results: the server does.
VITE_ARENA_WS_URL=ws://localhost:8787

# ── Accounts (Supabase) ───────────────────────────────────────────────────────
# Supabase project → Settings → API. Enables email + Google sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL of the deployed `checkout` edge function. Leave empty until payments are set up.
VITE_CHECKOUT_URL=

# ── Game server environment (not read by the browser) ────────────────────────
# PORT=8787
# SUPABASE_URL=            same project as above → the server persists profiles there with the service role key
# SUPABASE_SERVICE_ROLE_KEY=
# ALLOW_GUESTS=1           with Supabase configured, also accept anonymous guests (development only)
# BOT_AFTER_MS=5000        matchmaking falls back to a bot after this long
# DATA_FILE=server/data/profiles.json   where the in-memory store mirrors itself when Supabase is not set
